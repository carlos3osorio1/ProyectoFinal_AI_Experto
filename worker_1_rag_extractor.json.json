        "jsCode": "const results = $input.all();\nconst contexto = results.map(item => item.json.content || item.json.text || '').join('\\n\\n---\\n\\n');\nconst fuentes = results.map(item => item.json.metadata || {});\n\nconst entrada = $('When Executed by Another Workflow').item.json;\nconst mensajeCliente = entrada.mensaje_cliente || entrada.mensaje_original || entrada.message?.text || '';\n\nreturn [{\n  json: { contexto_rag: contexto, mensaje_cliente: mensajeCliente, fuentes_citadas: fuentes }\n}];"
      },
