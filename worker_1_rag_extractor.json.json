        "jsCode": "let rawText = $input.first().json.choices?.[0]?.message?.content || $input.first().json.text || \"\";\n\n// Elimina bloques de markdown\nlet cleanText = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\ntry {\n  const parsedJson = JSON.parse(cleanText);\n  return [{ json: parsedJson }];\n} catch (e) {\n  return [{ json: { \n    error: \"Formato JSON inválido devuelto por el LLM\", \n    raw_output: rawText,\n    fallback_action: \"REQUIERE_REVISION\" \n  }}];\n}"
      },
